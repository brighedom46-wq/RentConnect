@page "/my-requests"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using RentConnect.Data
@using RentConnect.Models

@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Requests</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h1>My Requests</h1>
        <p class="text-muted">
            Track your inquiries and assistance requests.
        </p>
    </div>

    @if (serviceRequests.Count == 0)
    {
        <div class="alert alert-info">
            You have not submitted any requests.
        </div>

        <a href="/apartments" class="btn btn-primary">
            Browse Apartments
        </a>
    }
    else
    {
        <div class="row g-4">
            @foreach (var request in serviceRequests)
            {
                <div class="col-lg-6">
                    <div class="card h-100 shadow-sm request-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <span class="badge bg-primary mb-2">
                                        @request.RequestType
                                    </span>

                                    <h4>@request.Subject</h4>
                                </div>

                                <div>
                                    @if (request.Status == "Open")
                                    {
                                        <span class="badge bg-danger">
                                            Open
                                        </span>
                                    }
                                    else if (request.Status == "In Progress")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            In Progress
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Resolved
                                        </span>
                                    }
                                </div>
                            </div>

                            <p>
                                <strong>Apartment:</strong>
                                @(request.Apartment?.Title ?? "Unknown apartment")
                            </p>

                            <p class="request-message">
                                @request.Message
                            </p>

                            <p class="text-muted small mb-0">
                                Sent:
                                @(request.DateCreated
                                    .ToLocalTime()
                                    .ToString("MMM d, yyyy h:mm tt"))
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .request-card {
        border: none;
        border-radius: 12px;
    }

    .request-message {
        white-space: pre-wrap;
    }
</style>

@code {
    private List<ServiceRequest> serviceRequests = [];

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var userId = authenticationState.User
            .FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        serviceRequests = await DbContext.ServiceRequests
            .AsNoTracking()
            .Include(request => request.Apartment)
            .Where(request => request.RenterId == userId)
            .OrderByDescending(request => request.DateCreated)
            .ToListAsync();
    }
}