@page "/my-bills"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Renter")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using RentConnect.Data
@using RentConnect.Models

@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Bills</PageTitle>

<div class="container py-5">
    <div class="mb-4">
        <h1 class="fw-bold">My Bills</h1>

        <p class="text-muted">
            View and pay your rent and utility bills.
        </p>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>

            <p class="text-muted mt-3">
                Loading your bills...
            </p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }
    else if (bills.Count == 0)
    {
        <div class="alert alert-info">
            You do not have any bills right now.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var bill in bills)
            {
                <div class="col-12 col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between
                                align-items-start mb-3">

                                <span class="badge bg-primary">
                                    @bill.BillType
                                </span>

                                <span class="badge @GetStatusClass(bill)">
                                    @GetDisplayStatus(bill)
                                </span>
                            </div>

                            <h4 class="fw-bold">
                                @bill.Apartment?.Title
                            </h4>

                            <p class="text-muted">
                                @bill.Apartment?.Address
                            </p>

                            <hr />

                            <div class="row mb-3">
                                <div class="col-6">
                                    <div class="small text-muted">
                                        Amount
                                    </div>

                                    <div class="fs-3 fw-bold text-success">
                                        @bill.Amount.ToString("C")
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="small text-muted">
                                        Due date
                                    </div>

                                    <div class="fw-semibold">
                                        @(bill.DueDate
                                            .ToString("MMM d, yyyy"))
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="small text-muted">
                                    Description
                                </div>

                                <div>@bill.Description</div>
                            </div>

                            @if (bill.Status == "Paid")
                            {
                                <div class="alert alert-success mb-0">
                                    Paid

                                    @if (bill.DatePaid.HasValue)
                                    {
                                        <span>
                                            on
                                            @(bill.DatePaid.Value
                                                .ToLocalTime()
                                                .ToString("MMM d, yyyy"))
                                        </span>
                                    }
                                </div>
                            }
                            else if (bill.DueDate.Date < DateTime.Today)
                            {
                                <div class="alert alert-danger mb-0">
                                    This bill is overdue.
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    Payment is due by
                                    @(bill.DueDate
                                        .ToString("MMM d, yyyy")).
                                </div>
                            }

                            @if (bill.Status != "Paid")
                            {
                                <a class="btn btn-success w-100 mt-3"
                                   href="@($"/pay-bill/{bill.Id}")">
                                    Pay Now
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<UtilityBill> bills = [];

    private bool isLoading = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            string? renterId = authenticationState.User
                .FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrWhiteSpace(renterId))
            {
                errorMessage =
                    "Your account information could not be found.";

                return;
            }

            bills = await DbContext.UtilityBills
                .AsNoTracking()
                .Include(bill => bill.Apartment)
                .Where(bill => bill.RenterId == renterId)
                .OrderBy(bill => bill.Status == "Paid")
                .ThenBy(bill => bill.DueDate)
                .ToListAsync();
        }
        catch
        {
            errorMessage =
                "Your bills could not be loaded. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetDisplayStatus(UtilityBill bill)
    {
        if (bill.Status == "Paid")
        {
            return "Paid";
        }

        if (bill.DueDate.Date < DateTime.Today)
        {
            return "Overdue";
        }

        return "Unpaid";
    }

    private static string GetStatusClass(UtilityBill bill)
    {
        return GetDisplayStatus(bill) switch
        {
            "Paid" => "bg-success",
            "Overdue" => "bg-danger",
            _ => "bg-warning text-dark"
        };
    }
}