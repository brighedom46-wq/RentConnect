@page "/landlord/edit-apartment/{ApartmentId:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Landlord")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using RentConnect.Data
@using RentConnect.Models

@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment WebHostEnvironment

<PageTitle>Edit Apartment</PageTitle>

<div class="container py-4">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="text-muted mt-3">Loading apartment...</p>
        </div>
    }
    else if (!apartmentFound)
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>

        <a class="btn btn-outline-primary"
           href="/landlord/apartments">
            Back to Manage Apartments
        </a>
    }
    else
    {
        <div class="form-container">
            <div class="mb-4">
                <h1>Edit Apartment</h1>

                <p class="text-muted">
                    Update the apartment details and manage its images.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            <EditForm Model="@apartment"
                      OnValidSubmit="@SaveApartment"
                      FormName="edit-apartment-form">

                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="mb-3">
                    <label class="form-label">Apartment title</label>

                    <InputText class="form-control"
                               @bind-Value="apartment.Title" />

                    <ValidationMessage For="@(() => apartment.Title)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Address</label>

                    <InputText class="form-control"
                               @bind-Value="apartment.Address" />

                    <ValidationMessage For="@(() => apartment.Address)" />
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Monthly rent</label>

                        <InputNumber class="form-control"
                                     @bind-Value="apartment.MonthlyRent"
                                     step="0.01" />

                        <ValidationMessage For="@(() => apartment.MonthlyRent)" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Bedrooms</label>

                        <InputNumber class="form-control"
                                     @bind-Value="apartment.Bedrooms" />

                        <ValidationMessage For="@(() => apartment.Bedrooms)" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Bathrooms</label>

                        <InputNumber class="form-control"
                                     @bind-Value="apartment.Bathrooms" />

                        <ValidationMessage For="@(() => apartment.Bathrooms)" />
                    </div>
                </div>

                @if (existingImages.Count > 0)
                {
                    <h5 class="mt-3">Current images</h5>

                    <div class="row g-3 mb-4">
                        @foreach (var image in existingImages)
                        {
                            <div class="col-6 col-md-4"
                                 @key="image.Id">

                                <div class="image-card">
                                    <img src="@image.ImageUrl"
                                         alt="Apartment image"
                                         class="image-preview" />

                                    @if (image.IsPrimary)
                                    {
                                        <span class="badge bg-primary primary-badge">
                                            Main image
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-dark primary-button"
                                                @onclick="() => MakePrimary(image)">
                                            Make main
                                        </button>
                                    }

                                    <button type="button"
                                            class="btn btn-sm btn-danger remove-button"
                                            @onclick="() => RemoveExistingImage(image)">
                                        Remove
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Add more images</label>

                    <InputFile class="form-control"
                               OnChange="@HandleImagesSelected"
                               accept=".jpg,.jpeg,.png,.webp"
                               multiple />

                    <div class="form-text">
                        You can keep up to 8 images. Each image must be
                        5 MB or smaller.
                    </div>
                </div>

                @if (selectedImages.Count > 0)
                {
                    <h5>New images</h5>

                    <div class="row g-3 mb-4">
                        @foreach (var image in selectedImages)
                        {
                            <div class="col-6 col-md-4" @key="image">
                                <div class="image-card">
                                    <img src="@image.PreviewUrl"
                                         alt="@image.FileName"
                                         class="image-preview" />

                                    <button type="button"
                                            class="btn btn-sm btn-danger remove-button"
                                            @onclick="() => RemoveSelectedImage(image)">
                                        Remove
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Description</label>

                    <InputTextArea class="form-control"
                                   @bind-Value="apartment.Description"
                                   rows="5" />

                    <ValidationMessage For="@(() => apartment.Description)" />
                </div>

                <div class="form-check mb-4">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="apartment.IsAvailable" />

                    <label class="form-check-label">
                        Apartment is available
                    </label>
                </div>

                <button type="submit"
                        class="btn btn-primary"
                        disabled="@isSaving">

                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2">
                        </span>

                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>

                <a href="/landlord/apartments"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>
            </EditForm>
        </div>
    }
</div>

<style>
    .form-container {
        max-width: 850px;
        margin: auto;
        padding: 30px;
        background-color: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    .image-card {
        position: relative;
    }

    .image-preview {
        width: 100%;
        height: 160px;
        object-fit: cover;
        border: 1px solid #dee2e6;
        border-radius: 10px;
    }

    .primary-badge,
    .primary-button {
        position: absolute;
        top: 8px;
        left: 8px;
    }

    .remove-button {
        position: absolute;
        right: 8px;
        bottom: 8px;
    }

    .validation-message {
        color: #dc3545;
        font-size: 0.875rem;
    }
</style>

@code {
    [Parameter]
    public int ApartmentId { get; set; }

    private const long MaximumImageSize = 5 * 1024 * 1024;
    private const int MaximumImageCount = 8;

    private Apartment apartment = new();
    private List<ApartmentImage> existingImages = [];
    private List<SelectedImage> selectedImages = [];

    private bool apartmentFound;
    private bool isLoading = true;
    private bool isSaving;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            string? landlordId = authenticationState.User
                .FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrWhiteSpace(landlordId))
            {
                errorMessage =
                    "Your landlord account could not be found.";

                return;
            }

            Apartment? existingApartment =
                await DbContext.Apartments
                    .Include(item => item.Images)
                    .FirstOrDefaultAsync(item =>
                        item.Id == ApartmentId);

            if (existingApartment is null)
            {
                errorMessage =
                    "The apartment could not be found.";

                return;
            }

            if (string.IsNullOrWhiteSpace(existingApartment.LandlordId))
            {
                existingApartment.LandlordId = landlordId;
            }
            else if (existingApartment.LandlordId != landlordId)
            {
                errorMessage =
                    "You are not authorized to edit this apartment.";

                return;
            }

            apartment = existingApartment;
            apartmentFound = true;

            existingImages = apartment.Images
                .OrderByDescending(image => image.IsPrimary)
                .ThenBy(image => image.DateUploaded)
                .ToList();

            if (existingImages.Count == 0 &&
                !string.IsNullOrWhiteSpace(apartment.ImageUrl))
            {
                var legacyImage =
                    new ApartmentImage
                    {
                        ApartmentId = apartment.Id,
                        ImageUrl = apartment.ImageUrl,
                        IsPrimary = true,
                        DateUploaded = DateTime.UtcNow
                    };

                DbContext.ApartmentImages.Add(legacyImage);
                existingImages.Add(legacyImage);
            }

            await DbContext.SaveChangesAsync();
        }
        catch (Exception exception)
        {
            errorMessage =
                $"The apartment could not be loaded. {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleImagesSelected(
        InputFileChangeEventArgs eventArgs)
    {
        errorMessage = null;
        selectedImages.Clear();

        int availableSpaces =
            MaximumImageCount - existingImages.Count;

        if (availableSpaces <= 0)
        {
            errorMessage =
                $"This apartment already has {MaximumImageCount} images.";

            return;
        }

        IReadOnlyList<IBrowserFile> files;

        try
        {
            files = eventArgs.GetMultipleFiles(availableSpaces);
        }
        catch
        {
            errorMessage =
                $"You can add only {availableSpaces} more image(s).";

            return;
        }

        string[] allowedContentTypes =
        [
            "image/jpeg",
            "image/png",
            "image/webp"
        ];

        foreach (var file in files)
        {
            if (!allowedContentTypes.Contains(file.ContentType))
            {
                selectedImages.Clear();

                errorMessage =
                    "Every image must be a JPG, PNG, or WebP file.";

                return;
            }

            if (file.Size > MaximumImageSize)
            {
                selectedImages.Clear();

                errorMessage =
                    $"The image '{file.Name}' is larger than 5 MB.";

                return;
            }

            await using Stream imageStream =
                file.OpenReadStream(MaximumImageSize);

            using MemoryStream memoryStream = new();

            await imageStream.CopyToAsync(memoryStream);

            byte[] imageBytes = memoryStream.ToArray();

            string extension = file.ContentType switch
            {
                "image/jpeg" => ".jpg",
                "image/png" => ".png",
                "image/webp" => ".webp",
                _ => throw new InvalidOperationException(
                    "Unsupported image format.")
            };

            selectedImages.Add(
                new SelectedImage
                {
                    FileName = file.Name,
                    Extension = extension,
                    Content = imageBytes,
                    PreviewUrl =
                        $"data:{file.ContentType};base64," +
                        Convert.ToBase64String(imageBytes)
                });
        }
    }

    private void RemoveSelectedImage(SelectedImage image)
    {
        selectedImages.Remove(image);
    }

    private async Task MakePrimary(ApartmentImage selectedImage)
    {
        foreach (var image in existingImages)
        {
            image.IsPrimary = image.Id == selectedImage.Id;
        }

        apartment.ImageUrl = selectedImage.ImageUrl;

        await DbContext.SaveChangesAsync();

        existingImages = existingImages
            .OrderByDescending(image => image.IsPrimary)
            .ThenBy(image => image.DateUploaded)
            .ToList();
    }

    private async Task RemoveExistingImage(ApartmentImage image)
    {
        bool wasPrimary = image.IsPrimary;

        DbContext.ApartmentImages.Remove(image);
        existingImages.Remove(image);

        if (wasPrimary)
        {
            ApartmentImage? newPrimary =
                existingImages.FirstOrDefault();

            if (newPrimary is not null)
            {
                newPrimary.IsPrimary = true;
                apartment.ImageUrl = newPrimary.ImageUrl;
            }
            else
            {
                apartment.ImageUrl = string.Empty;
            }
        }

        await DbContext.SaveChangesAsync();

        DeleteLocalImageFile(image.ImageUrl);
    }

    private async Task SaveApartment()
    {
        if (isSaving)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        List<string> savedImageUrls = [];

        try
        {
            bool needsPrimaryImage =
                existingImages.Count == 0;

            for (int index = 0;
                 index < selectedImages.Count;
                 index++)
            {
                string imageUrl =
                    await SaveImageFile(selectedImages[index]);

                savedImageUrls.Add(imageUrl);

                var newImage =
                    new ApartmentImage
                    {
                        ApartmentId = apartment.Id,
                        ImageUrl = imageUrl,
                        IsPrimary =
                            needsPrimaryImage && index == 0,
                        DateUploaded = DateTime.UtcNow
                    };

                DbContext.ApartmentImages.Add(newImage);

                if (newImage.IsPrimary)
                {
                    apartment.ImageUrl = imageUrl;
                }
            }

            await DbContext.SaveChangesAsync();

            NavigationManager.NavigateTo(
                "/landlord/apartments",
                forceLoad: true);
        }
        catch (Exception exception)
        {
            foreach (string imageUrl in savedImageUrls)
            {
                DeleteLocalImageFile(imageUrl);
            }

            errorMessage =
                $"The apartment could not be updated. {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task<string> SaveImageFile(
        SelectedImage image)
    {
        string fileName =
            $"{Guid.NewGuid():N}{image.Extension}";

        string uploadsFolder =
            Path.Combine(
                WebHostEnvironment.WebRootPath,
                "uploads",
                "apartments");

        Directory.CreateDirectory(uploadsFolder);

        string filePath =
            Path.Combine(uploadsFolder, fileName);

        await File.WriteAllBytesAsync(
            filePath,
            image.Content);

        return $"/uploads/apartments/{fileName}";
    }

    private void DeleteLocalImageFile(string imageUrl)
    {
        if (!imageUrl.StartsWith(
            "/uploads/apartments/",
            StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        string fileName = Path.GetFileName(imageUrl);

        string filePath =
            Path.Combine(
                WebHostEnvironment.WebRootPath,
                "uploads",
                "apartments",
                fileName);

        if (File.Exists(filePath))
        {
            File.Delete(filePath);
        }
    }

    private sealed class SelectedImage
    {
        public required string FileName { get; init; }
        public required string Extension { get; init; }
        public required byte[] Content { get; init; }
        public required string PreviewUrl { get; init; }
    }
}