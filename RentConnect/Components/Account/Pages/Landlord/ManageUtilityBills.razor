@page "/landlord/bills"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Landlord")]

@using Microsoft.EntityFrameworkCore
@using RentConnect.Data
@using RentConnect.Models

@inject ApplicationDbContext DbContext

<PageTitle>Manage Bills</PageTitle>

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center mb-4">

        <div>
            <h1 class="fw-bold">Manage Bills</h1>

            <p class="text-muted mb-0">
                View and update renters' utility bills.
            </p>
        </div>

        <a class="btn btn-primary mt-3 mt-md-0"
           href="/landlord/add-utility-bill">
            Add New Bill
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">
            @message
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>

            <p class="mt-3 text-muted">Loading bills...</p>
        </div>
    }
    else if (bills.Count == 0)
    {
        <div class="alert alert-info">
            No utility bills have been created yet.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var bill in bills)
            {
                <div class="col-12 col-lg-6">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between
                                align-items-start mb-3">

                                <div>
                                    <span class="badge bg-primary mb-2">
                                        @bill.BillType
                                    </span>

                                    <h4 class="mb-1">
                                        @bill.Apartment?.Title
                                    </h4>

                                    <small class="text-muted">
                                        @bill.Apartment?.Address
                                    </small>
                                </div>

                                <span class="badge @GetStatusClass(bill)">
                                    @GetDisplayStatus(bill)
                                </span>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Renter</div>

                                <div class="fw-semibold">
                                    @bill.RenterEmail
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-6">
                                    <div class="text-muted small">Amount</div>

                                    <div class="fs-4 fw-bold text-success">
                                        @bill.Amount.ToString("C")
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="text-muted small">Due date</div>

                                    <div class="fw-semibold">
                                        @(bill.DueDate.ToString("MMM d, yyyy"))
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Description</div>

                                <div>@bill.Description</div>
                            </div>

                            <div class="text-muted small mb-3">
                                Created:
                                @(bill.DateCreated
                                    .ToLocalTime()
                                    .ToString("MMM d, yyyy h:mm tt"))
                            </div>

                            @if (bill.Status == "Paid")
                            {
                                <button class="btn btn-outline-warning"
                                        @onclick="() => MarkAsUnpaid(bill)">
                                    Mark as Unpaid
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-success"
                                        @onclick="() => MarkAsPaid(bill)">
                                    Mark as Paid
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<UtilityBill> bills = [];

    private bool isLoading = true;

    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadBills();
    }

    private async Task LoadBills()
    {
        isLoading = true;

        bills = await DbContext.UtilityBills
            .Include(bill => bill.Apartment)
            .OrderBy(bill => bill.Status == "Paid")
            .ThenBy(bill => bill.DueDate)
            .ToListAsync();

        isLoading = false;
    }

    private async Task MarkAsPaid(UtilityBill bill)
    {
        bill.Status = "Paid";
        bill.DatePaid = DateTime.UtcNow;

        await DbContext.SaveChangesAsync();

        message = $"{bill.BillType} bill was marked as paid.";

        await LoadBills();
    }

    private async Task MarkAsUnpaid(UtilityBill bill)
    {
        bill.Status = "Unpaid";
        bill.DatePaid = null;

        await DbContext.SaveChangesAsync();

        message = $"{bill.BillType} bill was marked as unpaid.";

        await LoadBills();
    }

    private static string GetDisplayStatus(UtilityBill bill)
    {
        if (bill.Status == "Paid")
        {
            return "Paid";
        }

        if (bill.DueDate.Date < DateTime.Today)
        {
            return "Overdue";
        }

        return "Unpaid";
    }

    private static string GetStatusClass(UtilityBill bill)
    {
        string status = GetDisplayStatus(bill);

        return status switch
        {
            "Paid" => "bg-success",
            "Overdue" => "bg-danger",
            _ => "bg-warning text-dark"
        };
    }
}