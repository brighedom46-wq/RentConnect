@page "/my-payments"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Renter")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using RentConnect.Data
@using RentConnect.Models

@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Payment History | RentConnect</PageTitle>

<div class="container py-5">
    <div class="mb-4">
        <h1 class="fw-bold">Payment History</h1>

        <p class="text-muted">
            View your completed rent and utility payments.
        </p>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"
                 role="status">
            </div>

            <p class="text-muted mt-3">
                Loading your payments...
            </p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }
    else if (payments.Count == 0)
    {
        <div class="alert alert-info">
            You have not made any payments yet.
        </div>

        <a class="btn btn-primary"
           href="/my-bills">
            View My Bills
        </a>
    }
    else
    {
        <div class="card border-0 bg-primary text-white shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="small">
                            Total completed payments
                        </div>

                        <div class="display-6 fw-bold">
                            @GetTotalPaid().ToString("C")
                        </div>
                    </div>

                    <div class="col-md-6 text-md-end mt-3 mt-md-0">
                        <div class="small">
                            Number of payments
                        </div>

                        <div class="fs-3 fw-bold">
                            @payments.Count
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var payment in payments)
            {
                <div class="col-12 col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between
                                align-items-start mb-3">
                                <span class="badge bg-primary">
                                    @payment.PaymentMethod
                                </span>

                                <span class="badge bg-success">
                                    @payment.Status
                                </span>
                            </div>

                            <h4 class="fw-bold">
                                @(payment.UtilityBill?.Apartment?.Title
                                    ?? "Apartment")
                            </h4>

                            <p class="text-muted">
                                @(payment.UtilityBill?.Apartment?.Address
                                    ?? "Address unavailable")
                            </p>

                            <hr />

                            <div class="row mb-3">
                                <div class="col-6">
                                    <div class="small text-muted">
                                        Bill type
                                    </div>

                                    <div class="fw-semibold">
                                        @(payment.UtilityBill?.BillType
                                            ?? "Utility Bill")
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="small text-muted">
                                        Amount paid
                                    </div>

                                    <div class="fs-4 fw-bold text-success">
                                        @payment.Amount.ToString("C")
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="small text-muted">
                                    Payment date
                                </div>

                                <div class="fw-semibold">
                                    @(payment.PaymentDate
                                        .ToLocalTime()
                                        .ToString("MMM d, yyyy h:mm tt"))
                                </div>
                            </div>

                            <div>
                                <div class="small text-muted">
                                    Transaction reference
                                </div>

                                <div class="font-monospace text-break">
                                    @payment.TransactionReference
                                </div>
                            </div>

                            <a class="btn btn-outline-primary w-100 mt-4"
                               href="@($"/payment-receipt/{payment.Id}")">
                                View Receipt
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-4">
            <a class="btn btn-outline-primary"
               href="/my-bills">
                Back to My Bills
            </a>
        </div>
    }
</div>

@code {
    private List<Payment> payments = [];

    private bool isLoading = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            string? renterId = authenticationState.User
                .FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrWhiteSpace(renterId))
            {
                errorMessage =
                    "Your account information could not be found.";

                return;
            }

            payments = await DbContext.Payments
                .AsNoTracking()
                .Include(payment => payment.UtilityBill)
                .ThenInclude(bill => bill!.Apartment)
                .Where(payment => payment.RenterId == renterId)
                .OrderByDescending(payment => payment.PaymentDate)
                .ToListAsync();
        }
        catch
        {
            errorMessage =
                "Your payment history could not be loaded. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private decimal GetTotalPaid()
    {
        return payments
            .Where(payment => payment.Status == "Completed")
            .Sum(payment => payment.Amount);
    }
}